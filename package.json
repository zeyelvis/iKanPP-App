{
  "name": "kvideo",
  "version": "4.4.9",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync:sources": "node scripts/sync-ikanbot-sources.mjs",
    "sync:hero": "node scripts/sync-iyf-hero.mjs",
    "sync:hero:tv": "node scripts/sync-iyf-hero.mjs --target=tv",
    "sync:hero:movie": "node scripts/sync-iyf-hero.mjs --target=movie",
    "sync:hero:anime": "node scripts/sync-iyf-hero.mjs --target=anime",
    "sync:hero:variety": "node scripts/sync-iyf-hero.mjs --target=variety",
    "sync:hero:doc": "node scripts/sync-iyf-hero.mjs --target=doc",
    "sync:all": "node scripts/sync-ikanbot-sources.mjs && node scripts/sync-iyf-hero.mjs",
    "test:arch": "node scripts/test-architecture-integrity.mjs && node scripts/test-regression-suite.mjs && npx tsx scripts/test-latest-titles-404.mjs && npx tsx scripts/test-shadowline-matching.ts && npx tsx scripts/test-line-ranking.ts && npx tsx scripts/test-stale-build.ts",
    "test:404": "npx tsx scripts/test-latest-titles-404.mjs",
    "prepare": "git config core.hooksPath scripts/git-hooks || true",
    "seo:daemon:install": "bash scripts/cron/setup-daemon.sh",
    "seo:daemon:status": "bash scripts/cron/status-daemon.sh",
    "seo:daemon:uninstall": "bash scripts/cron/uninstall-daemon.sh",
    "seo:daemon:logs": "tail -f logs/seo-daemon.log",
    "seo:daemon:run": "node scripts/cron/autonomous-seo-daemon.mjs",
    "seo:dashboard": "node scripts/cron/dashboard.mjs",
    "preview": "opennextjs-cloudflare build && node scripts/drop-build-prerenders.mjs && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/drop-build-prerenders.mjs && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "core-js": "^3.50.0",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.575.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xgplayer": "^3.0.26",
    "xgplayer-hls": "^3.0.26",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@opennextjs/cloudflare": "^1.20.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^11.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.145.0"
  }
}
