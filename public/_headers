# Cloudflare Pages Custom Headers & Edge Cache Rules

# 全局静态资源强缓存
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# 影视实体详情页：边缘强缓存 7 天 (减少 95% KV 读取与计算成本，保障 Core Web Vitals TTFB < 50ms)
/title/*
  Cache-Control: public, max-age=3600, s-maxage=604800, stale-while-revalidate=86400
  CDN-Cache-Control: public, s-maxage=604800
  Cloudflare-CDN-Cache-Control: public, s-maxage=604800
  X-Robots-Tag: max-image-preview:large, max-snippet:-1, max-video-preview:-1

# 分类聚合页
/genre/*
  Cache-Control: public, max-age=3600, s-maxage=604800, stale-while-revalidate=86400
  CDN-Cache-Control: public, s-maxage=604800
  Cloudflare-CDN-Cache-Control: public, s-maxage=604800

# 导演与演员专栏聚合页
/director/*
  Cache-Control: public, max-age=3600, s-maxage=604800, stale-while-revalidate=86400
  CDN-Cache-Control: public, s-maxage=604800
  Cloudflare-CDN-Cache-Control: public, s-maxage=604800

/actor/*
  Cache-Control: public, max-age=3600, s-maxage=604800, stale-while-revalidate=86400
  CDN-Cache-Control: public, s-maxage=604800
  Cloudflare-CDN-Cache-Control: public, s-maxage=604800

# Sitemap 与 RSS 规范化
/*.xml
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400

